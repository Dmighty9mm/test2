# Copy to .env and fill in. Never commit .env.

# The domain pointing at this VPS (an A record). Caddy gets the HTTPS certificate for it.
PANEL_DOMAIN=client.plebmc.top
# The same address with https:// (used in links the game shows players)
PANEL_PUBLIC_URL=https://client.plebmc.top

# Shared secret between the panel and PlebioAPI (accounts.server-key in its config.yml).
# Make one with:  openssl rand -hex 32
PANEL_SERVER_KEY=

# Lets PlebMcBridge on the game servers send stats (stats.key in its config.yml).
# It can only send stats, nothing else. Make one with:  openssl rand -hex 32
PANEL_STATS_KEY=

# Shown in the page title and header
PANEL_SITE_NAME=PlebMc

# 1 = the website's Create account page works without a code from the game (same as the
# PlebMc client's start screen; max PANEL_CLIENT_REGISTRATIONS_PER_HOUR per IP).
# 0 = the website needs a sign-up code from an admin.
PANEL_OPEN_REGISTRATION=1
